FROM node:22-alpine AS builder
WORKDIR /workspace

RUN npm install -g pnpm@latest --quiet

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY artifacts/marzban-panel/ artifacts/marzban-panel/
COPY lib/ lib/

RUN pnpm install --frozen-lockfile --silent
RUN cd artifacts/marzban-panel && pnpm run build

# ── Runtime (Nginx statik) ────────────────────────────────────
FROM nginx:alpine AS runner
COPY --from=builder /workspace/artifacts/marzban-panel/dist/ /usr/share/nginx/html/
COPY deploy/panel-nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000
