# ╔══════════════════════════════════════════════════════════════╗
# ║  Marzban Panel — Örnek .env Dosyası                          ║
# ║  Kopyala: cp .env.example .env  →  değerleri doldur          ║
# ╚══════════════════════════════════════════════════════════════╝

# ─── Veritabanı ──────────────────────────────────────────────────────────────
# Format: postgresql://kullanici:sifre@host:5432/veritabani
DATABASE_URL=postgresql://marzban:your_db_password@localhost:5432/marzban

# ─── JWT ─────────────────────────────────────────────────────────────────────
# openssl rand -hex 32  →  ile güçlü bir secret üretin
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRE=24h

# ─── Sunucu ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
PANEL_DOMAIN=panel.example.com

# ─── Xray-core ───────────────────────────────────────────────────────────────
XRAY_BIN=/usr/local/bin/xray
XRAY_CONFIG=/etc/xray/config.json
XRAY_API_PORT=62050
XRAY_LOG_LEVEL=warning
XRAY_ACCESS_LOG=/var/log/xray/access.log
XRAY_ERROR_LOG=/var/log/xray/error.log

# SSL Sertifika dosyaları
XRAY_CERT_FILE=/etc/ssl/xray/cert.pem
XRAY_KEY_FILE=/etc/ssl/xray/key.pem

# Protokol ayarları
XRAY_WS_PATH=/ws
XRAY_GRPC_SERVICE=grpc
XRAY_SS_MASTER_PASS=change_this_shadowsocks_master_password

# Reality ayarları (opsiyonel)
XRAY_REALITY_DEST=google.com:443
XRAY_REALITY_SNI=google.com
XRAY_REALITY_PRIVATE_KEY=
XRAY_REALITY_SHORT_ID=

# ─── Docker (docker-compose.yml için) ────────────────────────────────────────
DB_PASSWORD=your_db_password_here
DOMAIN=panel.example.com
SSL_EMAIL=admin@example.com
